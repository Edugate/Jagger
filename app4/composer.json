{
  "name": "edugate/jagger-app4",
  "description": "CodeIgniter 4 application shell for the in-progress CI3->CI4 migration. See ../docs/CI4_MIGRATION.md.",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "codeigniter4/framework": "^4.7",
    "doctrine/orm": "^2.19",
    "doctrine/annotations": "^1.14",
    "doctrine/cache": "^1.14"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "models\\": "../application/models/",
      "Proxies\\": "../application/models/Proxies/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
